{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nu-chat",
  "account_id": "b7bcf45e2dc6e31a8a1e81af561a33c2",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{
    "pattern": "nu-pe-chat.cc.cd",
    "custom_domain": true,
    "zone_id": "44c48cdcc67074ecde5ca9cfcdb3f78a"
  }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "nu-chat-db",
    "database_id": "fbda1269-6747-46f9-93f0-828bb15dc14a",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "BARK_ENABLED": "true" },
  "secrets": { "required": ["CURSOR_SECRET", "BARK_ENCRYPTION_KEY"] },
  // Account has not enabled R2. No binding => backup/transfer features remain
  // unavailable and are absent from capabilities; never advertise mock storage.
  "observability": { "enabled": false }
}
